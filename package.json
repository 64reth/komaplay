{
  "name": "komaplay-react-router",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm exec react-router dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs pnpm exec react-router build",
    "preview": "pnpm build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typegen": "WRANGLER_LOG_PATH=.wrangler/logs pnpm exec wrangler types && pnpm exec react-router typegen",
    "typecheck": "pnpm typegen && pnpm exec tsc -b",
    "test": "node --import tsx --test tests/migration/*.test.ts",
    "lint": "pnpm exec eslint router-app workers tests/migration tests/e2e/*.spec.ts vite.config.ts react-router.config.ts playwright.config.ts",
    "deploy:canary": "pnpm build && WRANGLER_LOG_PATH=.wrangler/logs pnpm exec wrangler deploy --keep-vars",
    "deploy:canary:dry-run": "pnpm build && WRANGLER_LOG_PATH=.wrangler/logs pnpm exec wrangler deploy --dry-run --keep-vars",
    "test:e2e": "playwright test tests/e2e/migration-phase1.spec.ts tests/e2e/publication-phase2.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "isbot": "5.2.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "8.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260904.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.13",
    "wrangler": "4.127.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
